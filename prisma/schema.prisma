// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id            String   @id // matches Supabase auth.users.id
  email         String   @unique
  username      String   @unique
  displayName   String
  avatarUrl     String?
  bio           String?
  isAnonymous   Boolean  @default(false) // hides owner identity across the whole app
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pets          Pet[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  following     Follow[]  @relation("OwnerFollowing")
  followers     Follow[]  @relation("OwnerFollowers")
  sentMessages  Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  notifications Notification[]
  lostFoundPosts LostFoundPost[]
  adoptionListings AdoptionListing[]
  appointments  Appointment[]
  marketplaceListings MarketplaceListing[]
  stories       Story[]
  storyViews    StoryView[]
  reels         Reel[]
  reelLikes     ReelLike[]
}

model Pet {
  id           String   @id @default(cuid())
  ownerId      String
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  species      String
  breed        String?
  bio          String?
  birthDate    DateTime?
  avatarUrl    String?
  isAnonymous  Boolean  @default(false) // overrides owner visibility for this pet only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  healthLogs   HealthLog[]
  stories      Story[]
  reels        Reel[]
  lostFoundPosts LostFoundPost[]
  appointments Appointment[]

  @@index([ownerId])
}

model Post {
  id         String   @id @default(cuid())
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId      String?
  pet        Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)
  caption    String?
  mediaUrls  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments   Comment[]
  likes      Like[]
  hashtags   HashtagsOnPosts[]

  @@index([ownerId])
  @@index([petId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, ownerId])
  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Owner    @relation("OwnerFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Owner    @relation("OwnerFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Hashtag {
  id    String @id @default(cuid())
  tag   String @unique
  posts HashtagsOnPosts[]
}

model HashtagsOnPosts {
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     Owner    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Owner    @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      String   // e.g. "like", "comment", "follow", "lost_pet_nearby"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model HealthLog {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  type        String   // e.g. "vaccination", "vet_visit", "medication"
  title       String
  notes       String?
  date        DateTime
  reminderAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([petId])
}

model LostFoundPost {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId       String?
  pet         Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)
  status      String   @default("lost") // "lost" | "found"
  description String
  lastSeenLat Float?
  lastSeenLng Float?
  contactInfo String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([ownerId])
  @@index([petId])
}

model AdoptionListing {
  id          String   @id @default(cuid())
  posterId    String
  poster      Owner    @relation(fields: [posterId], references: [id], onDelete: Cascade)
  name        String
  species     String
  breed       String?
  age         String?
  gender      String?
  description String
  mediaUrls   String[]
  location    String?
  contactInfo String?
  status      String   @default("available") // "available" | "pending" | "adopted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([posterId])
}

model Vet {
  id         String   @id @default(cuid())
  name       String
  clinicName String
  location   String?
  bio        String?
  avatarUrl  String?
  rating     Float    @default(4.8)
  createdAt  DateTime @default(now())

  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetId       String
  vet         Vet      @relation(fields: [vetId], references: [id], onDelete: Cascade)
  reason      String
  scheduledAt DateTime
  status      String   @default("confirmed") // "confirmed" | "cancelled" | "completed"
  notes       String?
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([petId])
  @@index([vetId, scheduledAt])
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Owner    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  category    String
  price       Float
  description String
  mediaUrls   String[]
  location    String?
  status      String   @default("available") // "available" | "sold"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
}

model Story {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId     String?
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)
  mediaUrl  String
  caption   String?
  createdAt DateTime @default(now())
  // Stories disappear after 24h. Stored rather than computed so the cutoff is
  // fixed at creation time and queries can use a plain index on it.
  expiresAt DateTime

  views     StoryView[]

  @@index([ownerId])
  @@index([expiresAt])
}

model StoryView {
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Owner    @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@id([storyId, viewerId])
  @@index([viewerId])
}

model Reel {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId     String?
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)
  videoUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes     ReelLike[]

  @@index([ownerId])
  @@index([createdAt])
}

model ReelLike {
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([reelId, ownerId])
  @@index([ownerId])
}
